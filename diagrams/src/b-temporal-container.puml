@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Вариант 2: Temporal — C4 Container
Person(customer, "Клиент банка", "Сообщение и ACK приложения")
System_Ext(bank, "Банковские сервисы", "Собственный transactional outbox")
System_Ext(providers, "Push / SMS / email", "FCM/APNs и договорные провайдеры")
System_Boundary(platform, "Notification Platform") {
  Container(api, "Notification API + Relay", "Kotlin + Spring Boot", "Приём; StartWorkflow из outbox; bulk в Kafka")
  ContainerDb(ledger, "Critical Delivery Ledger", "PostgreSQL, sync HA", "Долгая дедупликация, разрешения и попытки")
  Container(temporal, "Temporal Service", "Self-hosted, 3 AZ", "История, task queues и устойчивые таймеры")
  ContainerDb(persistence, "Temporal Persistence", "Отдельный PostgreSQL HA", "История workflow; собственные реплики")
  Container(workflows, "Workflow Workers", "Kotlin + Spring / Java SDK", "Детерминированный процесс доставки")
  Container(activities, "Channel Activity Workers", "Kotlin + Spring / Java SDK", "Preflight, провайдерские API; idempotency")
  Container(receipts, "Receipt / Reconciliation", "Kotlin + Spring Boot", "Inbox receipt + outbox сигналов workflow")
  Container(policy, "Policy / Contact Service", "Kotlin + Spring Boot", "Настройки и разрешения отправки")
  ContainerDb(policydb, "Policy / Contact Store", "PostgreSQL HA", "Версии настроек; защищённые контакты")
  ContainerQueue(kafka, "Bulk / Status Log", "Apache Kafka, RF=3", "За пределами critical workflow-пути")
  Container(bulk, "Bulk Processor / Workers", "Kotlin + Spring Boot", "Отдельные массовые пулы и квоты")
  ContainerDb(bulkdb, "Bulk Store", "PostgreSQL HA", "Кампании и сервисные сообщения")
}
Rel(bank, api, "Стабильный event ID", "HTTPS")
Rel(api, ledger, "Critical + outbox", "SQL transaction")
Rel(api, temporal, "StartWorkflow(notification ID)", "gRPC; из outbox")
Rel(temporal, persistence, "Устойчивое состояние", "SQL")
Rel(workflows, temporal, "Poll / commands / timers", "gRPC")
Rel(activities, temporal, "Poll / activity result", "gRPC")
Rel(activities, ledger, "Разрешение/результат", "SQL")
Rel(activities, policy, "Политика и контакт", "HTTPS")
Rel_D(policy, policydb, "Актуальная политика", "SQL")
Rel(activities, providers, "Send / status lookup", "HTTPS")
Rel(providers, customer, "Доставляет сообщение")
Rel(customer, receipts, "ACK", "Authenticated HTTPS")
Rel(providers, receipts, "Delivery receipt", "Signed webhook")
Rel(receipts, ledger, "Inbox + статус + signal outbox", "SQL")
Rel(receipts, temporal, "Receipt Signal; из outbox", "gRPC")
Rel(api, bulkdb, "Bulk + outbox", "SQL")
Rel(api, kafka, "Bulk-события; из outbox")
Rel(kafka, bulk, "Массовая обработка")
Rel(bulk, bulkdb, "Состояние bulk", "SQL")
Rel(bulk, providers, "Bulk-send, отдельные квоты", "HTTPS")
